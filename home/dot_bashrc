#
# ~/.bashrc
#

# If not running interactively, don't do anything
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"
[[ $- != *i* ]] && return

# A relocated Zsh is not listed in /etc/shells. Prefer it for normal interactive
# terminals without changing system account data or noninteractive SSH commands.
# Use DOTFILES_KEEP_BASH=1 bash to deliberately keep an interactive Bash.
if [[ ${DOTFILES_KEEP_BASH:-0} != 1 && -z ${BASH_EXECUTION_STRING-} &&
      -f "$HOME/.local/opt/dotfiles-cli/packages.json" && -x "$HOME/.local/bin/zsh" ]]; then
  export SHELL="$HOME/.local/bin/zsh"
  if shopt -q login_shell; then
    exec "$SHELL" -l
  else
    exec "$SHELL"
  fi
fi

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '
if [ -f "$HOME/.asdf/asdf.sh" ]; then
  . "$HOME/.asdf/asdf.sh"
fi

# Source the Lazyman shell initialization for aliases and nvims selector
# shellcheck source=.config/nvim-Lazyman/.lazymanrc
[ -f ~/.config/nvim-Lazyman/.lazymanrc ] && source ~/.config/nvim-Lazyman/.lazymanrc
# Source the Lazyman .nvimsbind for nvims key binding
# shellcheck source=.config/nvim-Lazyman/.nvimsbind
[ -f ~/.config/nvim-Lazyman/.nvimsbind ] && source ~/.config/nvim-Lazyman/.nvimsbind

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init bash)"; fi
